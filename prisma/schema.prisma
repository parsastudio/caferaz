
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  unreviewed
  pending
  completed
  cancelled
}

enum CommentStatus {
  pending
  approved
  rejected
  spam
}

enum CouponType {
  product_direct
  conditional
  user_code
}

enum DiscountType {
  percentage
  fixed
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  stockGrams  Int         @map("stock_grams")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  deletedAt   DateTime?   @map("deleted_at")
  pricing     Pricing?
  comments    Comment[]
  orderItems  OrderItem[]
  coupons     Coupon[]

  @@map("products")
}

model Pricing {
  id                String  @id @default(cuid())
  productId         String  @unique @map("product_id")
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  pricePerKgArabica  Int     @map("price_per_kg_arabica")
  pricePerKgRobusta Int     @map("price_per_kg_robusta")

  @@map("pricing")
}

model Comment {
  id              String        @id @default(cuid())
  productId       String?       @map("product_id")
  product         Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String?       @map("user_id")
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // فیلدهای نام برای کاربران غیرعضو (مهمان) اختیاری می‌شوند
  firstName       String?       @map("first_name")
  lastName        String?       @map("last_name")
  
  rating          Int?
  commentText     String        @map("comment_text")
  createdAt       DateTime      @default(now()) @map("created_at")
  status          CommentStatus @default(pending)
  
  parentCommentId String?       @map("parent_comment_id")
  parentComment   Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]     @relation("CommentReplies")

  @@index([productId])
  @@index([parentCommentId])
  @@index([userId])
  @@map("comments")
}

model Order {
  id              String      @id @default(cuid()) // استفاده از cuid برای جلوگیری از تداخل شناسه در پروداکشن
  userId          String?     @map("user_id")
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  couponId        String?     @map("coupon_id")
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  finalPrice      Int         @map("final_price")
  customerName    String      @map("customer_name")
  customerPhone   String      @map("customer_phone")
  customerAddress String      @map("customer_address")
  createdAt       DateTime    @default(now()) @map("created_at")
  status          OrderStatus @default(unreviewed)
  orderItems      OrderItem[]

  @@index([userId])
  @@index([couponId])
  @@index([customerPhone])
  @@index([status])
  @@map("orders")
}

// جدول واسط جهت توسعه‌پذیری چندمحصولی در آینده و ذخیره‌سازی دقیق ویژگی‌های هر آیتم
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  weightGrams Int      @map("weight_grams")
  quantity    Int
  blend       String
  grind       String
  grindType   String   @map("grind_type")
  price       Int      // قیمت ثبت‌شده این آیتم در زمان خرید برای آرشیو مالی صحیح

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model User {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  address   String?
  orders    Order[]
  comments  Comment[]

  @@map("users")
}

model Coupon {
  id                String        @id @default(cuid())
  code              String        @unique
  type              CouponType
  discountType      DiscountType  @map("discount_type")
  discountValue     Int           @map("discount_value")
  productId         String?       @map("product_id")
  product           Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  minWeightGrams    Int?          @map("min_weight_grams")
  validFrom         DateTime?     @map("valid_from")
  validTo           DateTime?     @map("valid_to")
  maxDiscountAmount Int?          @map("max_discount_amount")
  isActive          Boolean       @default(true) @map("is_active")
  deletedAt         DateTime?     @map("deleted_at")
  allowStacking     Boolean       @default(false) @map("allow_stacking")
  usages            CouponUsage[]
  orders            Order[]

  @@index([productId])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String   @map("coupon_id")
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  phone    String
  usedAt   DateTime @default(now()) @map("used_at")

  @@unique([couponId, phone])
  @@map("coupon_usages")
}

model Option {
  key   String @id
  value Json

  @@map("options")
}

model OtpRecord {
  id        String   @id @default(cuid())
  phone     String
  code      String
  ip        String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  @@index([phone])
  @@index([expiresAt]) // ایندکس حیاتی برای کارایی بهینه‌تر کوئری‌های پاک‌سازی کرون‌جاب
  @@map("otp_records")
}